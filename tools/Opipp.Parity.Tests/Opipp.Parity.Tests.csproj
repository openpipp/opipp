<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- FakeEngine is a separate executable project nested here; do not compile its sources (or
         its generated obj/bin files) into the test assembly. -->
    <Compile Remove="FakeEngine/**/*.cs" />
    <None Remove="FakeEngine/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Opipp.Core\Opipp.Core.csproj" />
    <ProjectReference Include="..\Opipp.Parity\Opipp.Parity.csproj" />
    <ProjectReference Include="FakeEngine\Opipp.Parity.FakeEngine.csproj" />
  </ItemGroup>

</Project>
