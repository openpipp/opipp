# Parity harness scratch and outputs
# Generated parity output is ignored, but the small synthetic SER fixtures the transcript
# tests read are committed so a fresh clone can run the suite without first running the harness.
/parity/*
!/parity/*.ser
*.raw

# Local tooling
.dotnet-sdk/

# Published alpha builds are produced locally and never committed.
/dist/
