<Project>
  <!-- One place for the product identity. The version is deliberately a pre-release: this is an
       alpha reconstruction, not a replacement for the original until its author says so. -->
  <PropertyGroup>
    <Version>0.2.2-alpha</Version>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <Product>OPIPP (Open PIPP)</Product>
    <Company>OPIPP contributors</Company>
    <Description>Open, fully managed continuation of PIPP (Planetary Imaging PreProcessor). Not affiliated with the original project.</Description>
    <Copyright>Copyright (c) 2026 OPIPP contributors. GPLv3 or later. Not affiliated with PIPP or its author.</Copyright>
      <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
