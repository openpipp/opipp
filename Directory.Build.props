<Project>
  <!-- One place for the product identity. The version is deliberately a pre-release: this is an
       alpha reconstruction, not a replacement for the original until its author says so. -->
  <PropertyGroup>
    <Version>0.1.5-alpha</Version>
    <AssemblyVersion>0.1.5.0</AssemblyVersion>
    <FileVersion>0.1.5.0</FileVersion>
    <Product>OPIPP (Open PIPP)</Product>
    <Company>OPIPP contributors</Company>
    <Description>Open, managed continuation of PIPP (Planetary Imaging PreProcessor) by Chris Garry.</Description>
    <Copyright>Reconstruction of PIPP by Chris Garry; reconstruction and managed code by the OPIPP contributors.</Copyright>
      <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
